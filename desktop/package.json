{
  "name": "spartan-desktop",
  "version": "0.2.0-beta.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Spartan IDE desktop shell -- real Electron + React frontend driving the existing Rust core (spartan-buffer, tree-sitter, LSP/DAP, Leo, spartan-git) over a local IPC service. See CLAUDE.md/docs/architecture-spec.md for why this exists alongside crates/spartan-editor-core (the original wgpu-native shell, kept as the backend proof-of-concept and reference).",
  "homepage": "https://github.com/Spartan-Software-Enterprises/Spartan-IDE",
  "author": {
    "name": "CKissinger1988",
    "email": "80974097+CKissinger1988@users.noreply.github.com"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json && tsc --noEmit -p electron/tsconfig.preload.json",
    "package:linux": "npm run build && electron-builder --linux --publish=never",
    "package:win": "npm run build && electron-builder --win --publish=never",
    "package:mac": "npm run build && electron-builder --mac --publish=never"
  },
  "build": {
    "appId": "com.spartan-ide.SpartanIDE",
    "productName": "Spartan IDE",
    "copyright": "Copyright (c) 2026 CKissinger1988. All rights reserved. Proprietary and confidential.",
    "afterSign": "electron/afterSign.js",
    "publish": {
      "provider": "github",
      "owner": "Spartan-Software-Enterprises",
      "repo": "Spartan-IDE",
      "releaseType": "draft"
    },
    "directories": {
      "output": "dist-package",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "extraResources": [
        {
          "from": "../target/release/spartan-backend",
          "to": "spartan-backend"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "../target/release/spartan-backend.exe",
          "to": "spartan-backend.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "extraResources": [
        {
          "from": "../target/release/spartan-backend",
          "to": "spartan-backend"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.3.6",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.20.8"
  }
}
