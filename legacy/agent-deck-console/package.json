{
  "name": "spartan-ide",
  "version": "1.0.0",
  "description": "Spartan IDE is a high-performance, terminal-first command center for orchestrating AI CLIs via [Agent Deck](https://github.com/asheshgoplani/agent-deck). It features real-time usage tracking, autonomous model switching, and a dynamic web cockpit.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.spartan.ide",
    "productName": "Spartan_IDE",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "msi": {
      "oneClick": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "scripts/**/*",
      "web/**/*",
      "config/**/*",
      "bin/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      "config/ai-clis.tsv",
      "config/ai-skills.tsv",
      "config/usage-tracker.json",
      "config/neural-link.json"
    ]
  },
  "keywords": [],
  "author": "Spartan Team",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  }
}
